@startuml ^Simulation Pirates^

class Simulation {
    env : Environment
    object : []Object
    agents : []Agent

    Start()
}

class Environment {
    objects : []Object
    agents : []Agent
    pirates : []Ship
    privateer : []Ship
    merchant : []Ship
    army : []Ship
    filibuster : []Ship
    zoro : []Ship
    ports : []Port
}

class Object {
    pos : Position
}

class Port {
    merchandises : []Resource
}

class Resource {
    type : ResourceType
    quantity : int
}

enum ResourceType {
    Gold
    Spice
    Sugar
    Alcohol
    Weapons
    Provisions 
    Tea
    Coffee
    Tipiak
}

class Market {
    
}

class Agent {
    env : * Environment
    acuity : int
    health : int

    Percept()
    Act()
    Deliberate()
    MoveTowards(Object)
}


class Kraken {
    attack : int
    speed : int
    type : string

    Attack()
}

class Ship {
    behaviourCrew : BehaviourCrew
    statsShip : StatsShip
    resources : []Resource
    lifeMax : int
    attack : int
    defense : int
    speed : int
    level : int
    type : string

    IsLowLife()
}

class StatsShip {
    Ship : * Ship

    LevelUp()
    initStatsShip(*Ship)
}

class StatsShip_Brick {
}

class StatsShip_Brigantin {
}

class StatsShip_Goelette {
}

class StatsShip_TroisMatsCarres {
}

class BehaviourCrew {
    Ship : *Ship

    Percept()
    Act()
    Deliberate()
    Attack()
    ReceiveAttack()
    BuyResource()
    SellResource()
    FixShip()
}

class BehaviourCrew_Pirate {
}

class BehaviourCrew_Privateer {
}

class BehaviourCrew_Merchant {
}

class BehaviourCrew_Army {
}

class BehaviourCrew_Filibusteer {
}

class BehaviourCrew_PirateHunter {
}

class BehaviourCrew_Zoro {
}


Environment *-- Simulation

Object *-- Simulation
Object *-- Environment
Object <|-- Agent
Object <|-- Port

Agent *-- Simulation
Agent <|-- Kraken
Agent <|-- Ship

Ship <-- BehaviourCrew
Ship <-- StatsShip

BehaviourCrew o-- Ship
BehaviourCrew <|--  BehaviourCrew_Army
BehaviourCrew <|--  BehaviourCrew_PirateHunter
BehaviourCrew <|--  BehaviourCrew_Privateer
BehaviourCrew <|--  BehaviourCrew_Filibusteer
BehaviourCrew <|--  BehaviourCrew_Merchant
BehaviourCrew <|--  BehaviourCrew_Pirate
BehaviourCrew <|--  BehaviourCrew_Zoro

StatsShip o-- Ship
StatsShip <|-- StatsShip_Brick
StatsShip <|-- StatsShip_Brigantin
StatsShip <|-- StatsShip_Goelette
StatsShip <|-- StatsShip_TroisMatsCarres

@enduml